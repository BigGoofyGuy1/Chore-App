rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    match /choreProofs/{familyCode}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
                   request.resource.size < 10 * 1024 * 1024 && // Max 10MB
                   request.resource.contentType.matches('image/.*'); // Any image type
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
