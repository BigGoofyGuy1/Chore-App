{
  "expo": {
    "name": "Chore App",
    "slug": "chore-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "choreapp",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8fafc"
    },
    "android": {
      "package": "com.example.choreapp",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#f8fafc"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "52e8eccd-2b9e-4d54-8f53-6ab13a5ebb33"
      }
    },
    "plugins": [
      "@react-native-firebase/app"
    ],
    "owner": "biggoofyguy",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/52e8eccd-2b9e-4d54-8f53-6ab13a5ebb33"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.choreapp"
    }
  }
}
