{
  "expo": {
    "name": "Chore App",
    "slug": "chore-app",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "choreapp",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.biggoofyguy.goofytasks",
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#f8fafc"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "52e8eccd-2b9e-4d54-8f53-6ab13a5ebb33"
      }
    },
    "plugins": [
      "@react-native-firebase/app",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Chore App to choose proof photos from this device.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f8fafc"
        }
      ]
    ],
    "owner": "biggoofyguy",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/52e8eccd-2b9e-4d54-8f53-6ab13a5ebb33"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.biggoofyguy.goofytasks",
      "buildNumber": "3"
    }
  }
}
